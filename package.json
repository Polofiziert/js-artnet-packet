{
	"name": "js-artnet-packet",
	"version": "0.0.2",
	"description": "Jet another ArtNet Packet",
	"type": "module",
	"scripts": {
		"build": "tsup js-artnet-packet/lib/index.ts --format esm --dts --sourcemap --out-dir js-artnet-packet/dist --clean",
		"dev": "tsup js-artnet-packet/lib/index.ts --watch --format esm --dts --sourcemap --out-dir js-artnet-packet/dist",
		"test": "node test",
		"format": "prettier --write ."
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Polofiziert/js-artnet-packet.git"
	},
	"bugs": {
		"url": "https://github.com/Polofiziert/js-artnet-packet/issues"
	},
	"homepage": "https://github.com/Polofiziert/js-artnet-packet#readme",
	"main": "./js-artnet-packet/dist/index.js",
	"module": "./js-artnet-packet/dist/index.js",
	"types": "./js-artnet-packet/dist/index.d.ts",
	"exports": {
		".": {
			"import": "./js-artnet-packet/dist/index.js",
			"types": "./js-artnet-packet/dist/index.d.ts"
		}
	},
	"files": [
		"js-artnet-packet",
		"README.md",
		"LICENSE"
	],
	"author": "polofiziert",
	"license": "MIT",
	"keywords": [
		"Artnet",
		"ArtNet",
		"DMX",
		"Light",
		"Event"
	],
	"devDependencies": {
		"@types/node": "^26.6.6",
		"tsup": "^9.0.0",
		"typescript": "^7.0.2"
	},
	"packageManager": "pnpm@10.30.1"
}
